# DATABASE_URL - connection string do PostgreSQL (Supabase)
# Pobierz z: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[TWOJE_HASLO]@db.[PROJECT-REF].supabase.co:5432/postgres

# GEMINI_API_KEY - opcjonalne, jeśli używasz AI
GEMINI_API_KEY=your_key_here

# INNE ZMIENNE ŚRODOWISKOWE (jeśli używasz)
# PORT=3000
# PREFIX=!
# ADMINS=100060812419294,100089655356822
