# DATABASE_URL - connection string do PostgreSQL (Supabase)
# Pobierz z: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[TWOJE_HASLO]@db.[PROJECT-REF].supabase.co:5432/postgres

# === AI PROVIDER - CEREBRAS (priorytet) ===
# Klucz z https://cloud.cerebras.ai  (prefix csk-)
CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model Cerebras - domyślnie qwen-3.8-27b, możesz zmienić np. na llama-3.3-70b, qwen-3-235b-a22b-instruct-2507
CEREBRAS_MODEL=qwen-3.8-27b
# Dodatkowe klucze Cerebras (opcjonalnie, rotacja)
# CEREBRAS_API_KEY_2=csk-xxxx
# CEREBRAS_API_KEYS=csk-xxx1,csk-xxx2

# === AI PROVIDER - GROQ (fallback) ===
# Jeśli nie masz Cerebras, bot użyje Groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=qwen/qwen3-32b
# GROQ_API_KEY_2=gsk_xxxx

# GEMINI_API_KEY - opcjonalne, jeśli używasz AI (legacy)
GEMINI_API_KEY=your_key_here

# INNE ZMIENNE ŚRODOWISKOWE (jeśli używasz)
# PORT=3000
# PREFIX=!
# ADMINS=100060812419294,100089655356822
